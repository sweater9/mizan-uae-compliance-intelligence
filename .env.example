# Server-side only. Never expose this value through Vite or commit a real key.
NVIDIA_API_KEY=
# NVIDIA NIM endpoint and model.
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Allowed browser origin for the backend API.
CORS_ORIGIN=http://localhost:3000
# Provider-agnostic signed session verification. Keep the JWKS URL server-side.
MIZAN_AUTH_JWKS_URL=
MIZAN_AUTH_ISSUER=
MIZAN_AUTH_AUDIENCE=
MIZAN_AUTH_PROVIDER=default
MIZAN_AUTH_LOGIN_URL=
# Optional outside Render; safe build/release identifier returned by health.
APP_VERSION=

# Provider-agnostic signed session verification (all are required in production).
# The backend accepts a Bearer token or an HttpOnly `mizan_session` cookie.
MIZAN_AUTH_ISSUER=
MIZAN_AUTH_AUDIENCE=
MIZAN_AUTH_JWKS_URL=
MIZAN_AUTH_PROVIDER=default
# Optional hosted sign-in URL used by the minimal auth screen.
MIZAN_AUTH_LOGIN_URL=

# Public backend origin for GitHub Pages only (not a secret).
# VITE_API_BASE_URL=https://your-backend.onrender.com
# CORS_ORIGIN accepts exact comma-separated origins. Same-origin works without it.
